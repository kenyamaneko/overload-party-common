{
  "name": "@kenyamaneko/overload-party-gamedata",
  "version": "0.0.0",
  "description": "Auto-generated game constants and event data types for Overload Party",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./game-design": "./dist/gameDesign.js",
    "./game-logic": "./dist/gameLogic.js",
    "./ws": "./dist/ws.js",
    "./shop": "./dist/shop.js",
    "./newsfeed": "./dist/newsfeed.js",
    "./eventData": "./dist/eventData.js",
    "./variantTypes": "./dist/variantTypes.js",
    "./models": "./dist/models.js"
  },
  "typesVersions": {
    "*": {
      "game-design": [
        "dist/gameDesign.d.ts"
      ],
      "game-logic": [
        "dist/gameLogic.d.ts"
      ],
      "ws": [
        "dist/ws.d.ts"
      ],
      "shop": [
        "dist/shop.d.ts"
      ],
      "newsfeed": [
        "dist/newsfeed.d.ts"
      ],
      "eventData": [
        "dist/eventData.d.ts"
      ],
      "variantTypes": [
        "dist/variantTypes.d.ts"
      ],
      "models": [
        "dist/models.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenyamaneko/overload-party-common.git",
    "directory": "packages/gamedata-npm"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
