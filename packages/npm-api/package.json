{
  "name": "@kenyamaneko/overload-party-api",
  "version": "0.1.0",
  "description": "Auto-generated API contract types (REST, WebSocket, models) for Overload Party",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./models": "./dist/models.js",
    "./wsMessages": "./dist/wsMessages.js"
  },
  "typesVersions": {
    "*": {
      "models": [
        "dist/models.d.ts"
      ],
      "wsMessages": [
        "dist/wsMessages.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenyamaneko/overload-party-common.git",
    "directory": "packages/npm-api"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
